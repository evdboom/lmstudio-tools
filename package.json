{
  "name": "lmstudio-tools",
  "version": "0.1.0",
  "description": "MCP servers for LM Studio: sandboxed file tools plus a skills/workflow framework.",
  "type": "module",
  "bin": {
    "lmstudio-tools": "dist/index.js",
    "lmstudio-skills": "dist/skills-index.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "start:skills": "node dist/skills-index.js",
    "dev:skills": "tsx src/skills-index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
