{
  "name": "lmstudio-tools",
  "version": "0.1.0",
  "description": "MCP servers for LM Studio: sandboxed file tools, skills/workflows, and beat-based story telling.",
  "type": "module",
  "bin": {
    "lmstudio-tools": "dist/index.js",
    "lmstudio-skills": "dist/skills-index.js",
    "story-teller-mcp": "dist/story-teller-index.js",
    "story-reader": "dist/reader-server.js"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "start:skills": "node dist/skills-index.js",
    "dev:skills": "tsx src/skills-index.ts",
    "start:story": "node dist/story-teller-index.js",
    "dev:story": "tsx src/story-teller-index.ts",
    "build:reader": "vite build --config reader/vite.config.ts",
    "build:all": "npm run build && npm run build:reader",
    "start:reader": "node dist/reader-server.js",
    "dev:reader": "npm run build:reader && tsx src/reader-server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "npm run build:all && playwright test",
    "migrate:stories": "node dist/migrate-cli.js"
  },
  "dependencies": {
    "@fastify/static": "^7.0.4",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "fastify": "^4.29.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "undici": "^6.28.0",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
